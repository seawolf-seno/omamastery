pkgname=omamastery
pkgver=0.2.0
pkgrel=2
pkgdesc='Mastery gradebook and planning hub for teachers, shaped with their AI agent'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
optdepends=('libsecret: keep the Canvas and Blackbaud connection in your keyring'
            'xdg-utils: open the Blackbaud sign-in in your browser')
makedepends=('gcc' 'make' 'tomlplusplus')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omamastery "$pkgdir/usr/bin/omamastery"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omamastery.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omamastery.svg"
  install -Dm644 "$startdir/omamastery.desktop" "$pkgdir/usr/share/applications/omamastery.desktop"
}
